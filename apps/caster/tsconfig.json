{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Node globals, no DOM. It launches a surface; it does not render into one.
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
  // No "references" on purpose: caster consumes runtime's built artifact, not its source.
}
