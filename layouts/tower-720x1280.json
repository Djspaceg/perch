      "fit": "cover"
    },
    {
      "kind": "text",
      "text": "Tower",
      "rect": { "x": 40, "y": 40, "w": 640, "h": 84 },
      "style": {
        "--perch-text-size": "3.25rem",
        "--perch-text-weight": "700",
        "--perch-text-tracking": "0.02em",
        "--perch-text-color": "#1d1a15"
      }
    },
    {
      "kind": "text",
      "text": "workstation · south wall",
      "rect": { "x": 40, "y": 128, "w": 640, "h": 30 },
      "style": {
        "--perch-text-size": "1.125rem",
        "--perch-text-tracking": "0.08em",
        "--perch-text-color": "#8a7f6b"
      }
    },
    {
      "kind": "text",
      "text": "mock source · generated values, not hardware",
      "rect": { "x": 40, "y": 162, "w": 640, "h": 28 },
      "style": {
        "--perch-text-size": "0.8125rem",
