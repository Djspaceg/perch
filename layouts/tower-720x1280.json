{
  "schemaVersion": 1,
  "target": { "width": 720, "height": 1280, "frameRate": 24 },
  "theme": {
    "--perch-canvas-bg": "#f4efe6",
    "--perch-letterbox-bg": "#1c1915",
    "--perch-font": "ui-serif, Georgia, 'Times New Roman', serif",
    "--perch-fg": "#1d1a15",
    "--perch-dim": "#6d6353",
    "--perch-faint": "#a89d8a",
    "--perch-stale": "#8a5b3c",
    "--perch-warn": "#8a6a1f",
    "--perch-alert": "#9a3b25",
    "--perch-value-weight": "600",
    "--perch-value-size-min": "2rem",
    "--perch-value-size-max": "4rem",
    "--perch-unit-size": "1.5rem",
    "--perch-label-size": "1.125rem",
    "--perch-text-color": "#6d6353",
    "--perch-media-opacity": "0.5"
  },
  "elements": [
    {
      "kind": "media",
